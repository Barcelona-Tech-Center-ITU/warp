# Environment for the Dokploy Compose service — paste into Dokploy's
# Environment tab (Dokploy writes it to .env next to docker-compose.yml).
# Everything here is injected into warp-app, so any WARP_* setting from
# ../../CONFIGURATION.md can be added below.

# --- required ---------------------------------------------------------------

# Flask cookie-signing key. Generate one: openssl rand -hex 32
WARP_SECRET_KEY=change-me

# PostgreSQL credentials, used by both containers. The database is created on
# first start; changing the password later needs a manual ALTER ROLE.
POSTGRES_PASSWORD=change-me

# --- optional ---------------------------------------------------------------

POSTGRES_DB=warp
POSTGRES_USER=warp

# Default timezone for new plans and reminder scheduling.
TZ=UTC

# Set to false only while testing over plain http (see docker-compose.yml).
WARP_SESSION_COOKIE_SECURE=true

# Locales offered in the language picker, and the fallback.
# WARP_LANGUAGES=["en","de","fr","es","pl"]
# WARP_DEFAULT_LANGUAGE=en

# Seed sample zones/users on first start (demo only; the schema and the initial
# admin account are created automatically on an empty database).
# WARP_DATABASE_POST_INIT_SCRIPTS=["sql/sample_data.sql"]
